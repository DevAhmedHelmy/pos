# POS app environment variables (Tauri reads these via Vite)
# Prefix public variables with VITE_ to expose them to the renderer process

# Cloud API base URL (used by sync engine)
VITE_API_URL=http://localhost:3001

# Local SQLite path is resolved at runtime by the Rust side via Tauri's app_data_dir()
# No env var needed — path is managed by src-tauri/src/db.rs
