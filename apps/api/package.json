    "@nestjs/passport": "^10.0.3",
    "@nestjs/config": "^3.3.0",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/swagger": "^7.4.2",
    "@pos/config": "workspace:*",
    "@pos/db-cloud": "workspace:*",
    "@pos/shared": "workspace:*",
    "@pos/sync": "workspace:*",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/passport-jwt": "^4.0.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
