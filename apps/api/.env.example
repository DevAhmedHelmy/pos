# NestJS API environment variables
NODE_ENV=development
PORT=3001

# PostgreSQL (via docker-compose.dev.yml)
DATABASE_URL=postgresql://pos_user:pos_pass@localhost:5432/pos_db

# Redis (via docker-compose.dev.yml)
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET_KEY
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_REFRESH_SECRET_KEY_HERE
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000
