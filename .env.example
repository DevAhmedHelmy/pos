# Root .env.example — copy to .env and fill in values before running locally
# Individual apps also have their own .env.example files

# ─── Docker / Infrastructure ─────────────────────────────────────────────────
POSTGRES_DB=pos_db
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── API (apps/api/.env.example for full list) ────────────────────────────────
DATABASE_URL=postgresql://pos_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/pos_db
REDIS_URL=redis://localhost:6379

JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET_KEY
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_REFRESH_SECRET_KEY_HERE

# ─── Admin (apps/admin/.env.example for full list) ────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
